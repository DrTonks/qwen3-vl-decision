          "payment_dispute": "重复扣款、还款后账单不符或扣款争议",
          "security": "盗用身份、诈骗、泄露验证码或账户安全风险",
          "handoff": "明确要求人工服务或投诉升级",
          "general": "一般知识、闲聊、业务外问题或不确定诉求"
        }
      },
      "route": {
        "instructions": "结合已知状态、工具和优先级，选择下一步路由。",
        "criteria": {
          "tool": "调用现有只读工具获取尚未给出的真实业务记录",
          "clarify": "追问缺失信息或要求先登录",
          "llm": "将一般咨询或已有充分事实的解释交给回复模型",
